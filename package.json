    "testes-unitarios": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^20.11.30",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "mock-fs": "^5.5.0",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
