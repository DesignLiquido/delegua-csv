{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["fontes/**/*", "delegua-modulo.ts", "testes/**/*"]
}
